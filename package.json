{
  "name": "envwatch",
  "displayName": "EnvWatch",
  "publisher": "GustavoTomanini",
  "description": "Detects missing environment variables in Laravel, Spring Boot, Node.js and Symfony projects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gtomanini/envwatch-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/gtomanini/envwatch-vscode/issues"
  },
  "homepage": "https://github.com/gtomanini/envwatch-vscode#readme",
  "keywords": [
    "env",
    "dotenv",
    "environment variables",
    "laravel",
    "symfony",
    "spring boot",
    "nodejs"
  ],
  "version": "0.1.0",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "workspaceContains:**/.env",
    "workspaceContains:**/application.properties",
    "workspaceContains:**/application.yml",
    "workspaceContains:**/package.json",
    "workspaceContains:**/symfony.lock",
    "workspaceContains:**/bin/console"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "envwatch",
          "title": "EnvWatch",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "envwatch": [
        {
          "id": "envwatch.panel",
          "name": "Environment Variables"
        }
      ]
    },
    "commands": [
      {
        "command": "envwatch.scan",
        "title": "EnvWatch: Scan Project",
        "icon": "$(refresh)"
      },
      {
        "command": "envwatch.openFile",
        "title": "Open File"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "envwatch.scan",
          "when": "view == envwatch.panel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "EnvWatch",
      "properties": {
        "envwatch.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information"
          ],
          "default": "warning",
          "description": "Severity level for missing environment variable diagnostics"
        },
        "envwatch.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/vendor/**",
            "**/node_modules/**",
            "**/target/**"
          ],
          "description": "Glob patterns to exclude from scanning"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "node node_modules/.bin/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@types/vscode": "^1.146.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.62.1",
    "@vscode/vsce": "^4.1.1",
    "eslint": "^10.15.0",
    "typescript": "^7.0.2"
  }
}
